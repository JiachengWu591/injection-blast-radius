{
  "name": "injection-blast-radius",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Everything version-specific lives in mise.toml, not here. This file only
  // has to put `mise` on the PATH; mise then installs the pinned Python and
  // uv, so a Codespace and a laptop run the same interpreter.
  // Invoked through bash rather than executed directly: the repo is authored
  // on Windows, where git does not carry an executable bit to set.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Only `mise run demo:live` and `mise run matrix` need this. The default
  // demo replays recorded exchanges and needs no key at all, so leaving this
  // blank is a supported way to use the repo, not a broken setup.
  "secrets": {
    "DEEPSEEK_API_KEY": {
      "description": "Optional. Needed only for the live tasks (demo:live, matrix); `mise run demo` works without it.",
      "documentationUrl": "https://platform.deepseek.com/api_keys"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
