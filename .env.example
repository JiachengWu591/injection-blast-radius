# Copy this file to .env and paste your DeepSeek API key:
#   cp .env.example .env
#
# .env is gitignored. This key is the only real credential the project uses.
# It is read from the environment and nothing else: never written to a file,
# never logged, never printed.
DEEPSEEK_API_KEY=

# Note: the *fake* secret this demo tries to protect does NOT live here.
# It is written to sandbox/.env at startup (see ibr/config.py:BAIT_ENV_CONTENT)
# and exists only to give the simulated attack something to reach for.
