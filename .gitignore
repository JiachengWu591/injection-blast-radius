# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling artifacts
.coverage
.coverage.*
.mypy_cache/
.ruff_cache/

# Secrets — never commit real credentials
.env
.env.local

# Sandbox runtime artifacts (regenerated by the demo, not source).
# sandbox/.env is the fake bait secret; it is written by ibr.bootstrap at
# startup rather than committed, so that no file named ".env" ever lives in
# git history.
sandbox/.env
sandbox/public_comments.txt
sandbox/labels.txt
sandbox/report.md
sandbox/batch_report.md
sandbox/false_positive_rate*.md

# Real issue text: copyright its authors, and de-identification is not complete.
# The repo publishes tools/fetch_real_corpus.py, never its output. PROJECT_SPEC.md 6.1.
sandbox/corpus/real.jsonl
sandbox/attack_matrix.md
sandbox/audit_variance.md
sandbox/model_comparison.md
sandbox/logs/
sandbox/audit_samples.jsonl
sandbox/audit_samples.*.jsonl
sandbox/*.log
sandbox/*.jsonl

# The throwaway worktree `verify.py` builds to run the offline suites with no
# .env, as CI sees them. Removed in a `finally`, but a hard kill or a held file
# handle can leave it — and an untracked, un-ignored second copy of the tree
# sitting in the repo root right before a push is the wrong thing to discover
# by reading `git status`.
.verify-clean/
